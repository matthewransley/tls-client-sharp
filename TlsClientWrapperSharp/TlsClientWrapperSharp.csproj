<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        
        <!-- NuGet Package Metadata -->
        <PackageId>tls-client-sharp</PackageId>
        <Version>1.0.0</Version>
        <Authors>Matthew Ransley</Authors>
        <Company>Matthew Ransley</Company>
        <Description>A C# wrapper for bogdanfinn/tls-client, providing HttpClientHandler for TLS fingerprint spoofing with automatic native library management.</Description>
        <RepositoryUrl>https://github.com/matthewransley/tls-client-sharp</RepositoryUrl>
        <PackageTags>tls, client, httpclient, fingerprint, spoofing, csharp, native</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Exceptions\" />
      <Folder Include="Utils\" />
    </ItemGroup>

</Project>
